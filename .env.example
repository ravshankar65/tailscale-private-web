# Copy to .env and fill in.  .env is git-ignored -- never commit secrets.
#   cp .env.example .env

# --- Tailnet identity -------------------------------------------------------
# The login you use for the Tailscale admin console (your Google account).
ADMIN_EMAIL=you@gmail.com
# Optional: comma-separated logins for the "contractor" persona (web app only).
# Leave empty if you are not demoing a second user.
CONTRACTOR_EMAILS=
# Your tailnet DNS name, from Admin console -> DNS (e.g. tail1234ab.ts.net).
TAILNET_DNS=tailXXXXXX.ts.net

# --- Ubuntu host ------------------------------------------------------------
# The Linux account engineers are allowed to SSH in as (via Tailscale SSH).
LINUX_USER=rshankar
# Tailscale machine name for the host.
HOST_TS_NAME=homelab
# The host's LAN IP. Used ONLY by validate.sh to prove nothing is exposed on the LAN.
HOST_LAN_IP=192.168.1.50
# Ports that must be CLOSED on the host LAN IP (validate.sh). Include anything Docker publishes.
LAN_CHECK_PORTS="80 443 8080 5678 8000 8082 8083 9000"

# --- Secrets ----------------------------------------------------------------
# API access token: Admin console -> Settings -> Keys -> "Generate access token".
# Used by apply-policy.sh and mint-authkey.sh (Mac side only). Short expiry recommended.
TS_API_KEY=tskey-api-REPLACE_ME

# Pre-auth keys (single-use, pre-approved, tagged). Generate with:
#   ./scripts/mint-authkey.sh tag:server   -> TS_AUTHKEY_HOST
#   ./scripts/mint-authkey.sh tag:web      -> TS_AUTHKEY_WEB
TS_AUTHKEY_HOST=tskey-auth-REPLACE_ME
TS_AUTHKEY_WEB=tskey-auth-REPLACE_ME

# Optional: pin the tailscale container image (default: stable).
TS_IMAGE_TAG=stable

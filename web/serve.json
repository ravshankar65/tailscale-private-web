{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:80"
        },
        "/whoami": {
          "Proxy": "http://127.0.0.1:8080/whoami"
        },
        "/me": {
          "Proxy": "http://127.0.0.1:8080/me"
        },
        "/healthz": {
          "Proxy": "http://127.0.0.1:8080/healthz"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false
  }
}
